{
  "expo": {
    "name": "KetaPOS",
    "slug": "ketapos",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "ketapos",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "uz.ketaone.ketapos"
    },
    "android": {
      "package": "uz.ketaone.ketapos",
      "edgeToEdgeEnabled": true
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "KetaPOS mahsulot shtrix-kodini o‘qish uchun kameradan foydalanadi.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ]
    ]
  }
}
